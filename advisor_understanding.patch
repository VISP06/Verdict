+def test_one_sentence_with_everything_goes_straight_to_the_report():
+    session = TerminalSession("user_07")
+    blocks = session.handle(REFRIGERATOR)
+    assert [block["kind"] for block in blocks] == ["report"]
+    text = _report_text(blocks)
+    assert "Refrigerator · INR 50,000.00 · pay by 2024-10-31 · paying in full" in text
+    for section in ("UNDERSTOOD AS", "WHY", "HEADROOM", "AHEAD", "OPTIONS", "ALTERNATIVES", "NEXT STEPS"):
