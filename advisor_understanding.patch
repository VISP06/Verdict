+
+@pytest.mark.parametrize("text,expected", [
+    ("by the end of next month", dt.date(2024, 10, 31)),
+    ("by the end of this month", dt.date(2024, 9, 30)),
+    ("end of the year", dt.date(2024, 12, 31)),
+    ("in 10 days", dt.date(2024, 9, 14)),
+    ("within 2 weeks", dt.date(2024, 9, 18)),
+    ("within a month", dt.date(2024, 10, 4)),
+    ("in three months", dt.date(2024, 12, 4)),
+    ("tomorrow", dt.date(2024, 9, 5)),
+    ("next week", dt.date(2024, 9, 11)),
+    ("next month", dt.date(2024, 10, 4)),
+    ("by friday", dt.date(2024, 9, 6)),
+    ("by monday", dt.date(2024, 9, 9)),
+    ("by 15 Dec", dt.date(2024, 12, 15)),
+    ("by December 15th", dt.date(2024, 12, 15)),
+    ("by the 20th", dt.date(2024, 9, 20)),
+    ("by December", dt.date(2024, 12, 31)),
+    ("on 2024-12-01", dt.date(2024, 12, 1)),
+    ("by 31/12/2024", dt.date(2024, 12, 31)),
+])
+def test_deadline_phrases(text, expected):
+    assert parse_deadline_phrase(text, AS_OF)["date"] == expected
+
+
+def test_deadline_flags_and_locale():
+    assert parse_deadline_phrase("by 2020-01-01", AS_OF)["past"] is True
+    assert parse_deadline_phrase("by 2020-01-01", AS_OF)["date"] is None
+    assert parse_deadline_phrase("no deadline please", AS_OF)["no_deadline"] is True
+    assert parse_deadline_phrase("by 03/04/2025", AS_OF, day_first=True)["date"] == dt.date(2025, 4, 3)
+    assert parse_deadline_phrase("by 03/04/2025", AS_OF, day_first=False)["date"] == dt.date(2025, 3, 4)
+    assert parse_deadline_phrase("laptop 12k", AS_OF)["date"] is None
+
+
+@pytest.mark.parametrize("text,installments,count,partial", [
+    ("I will pay in full without any installments", False, None, False),
+    ("buy a sofa worth 95k in full", False, None, False),
+    ("I can't pay in full", None, None, None),
+    ("no emi please", False, None, None),
+    ("pay in 6 installments", True, 6, None),
+    ("three monthly payments", True, 3, None),
+    ("partial payment is fine", None, None, True),
+    ("laptop 12k", None, None, None),
+])
+def test_payment_mode(text, installments, count, partial):
+    mode = parse_payment_mode(text)
+    assert (mode["allow_installments"], mode["installment_count"], mode["allow_partial"]) == (installments, count, partial)
+
+
+def test_payment_mode_fractions():
+    assert parse_payment_mode("pay half now")["partial_fraction"] == 0.5
+    assert parse_payment_mode("pay 20% now")["partial_fraction"] == pytest.approx(0.2)
+    assert parse_payment_mode("pay 10k now and the rest later")["partial_amount_text"].startswith("10k")
+
+
+@pytest.mark.parametrize("text,item", [
+    ("Can I buy a Refrigerator worth 50k INR by the end of next month?", "Refrigerator"),
+    ("laptop 12k", "Laptop"),
+    ("TV 45,000 by the 20th", "TV"),
+    ("Can I afford an iPhone 15 for 80000", "iPhone"),
+    ("pay 10k now and rest later for the sofa", "Sofa"),
+])
+def test_item_extraction(text, item):
+    assert extract_item(parse_request_cleaned(text)) == item
+
+
+def parse_request_cleaned(text):
+    return text
+
+
+def test_intents():
+    assert classify_intents("what is my current bank balance?") == ["balance"]
+    assert classify_intents("what is the most expensive thing I can afford right now") == ["max_affordable"]
+    assert classify_intents("what bills are coming up?") == ["upcoming"]
+    assert classify_intents("when is my next salary?") == ["upcoming"]
+    assert classify_intents("what is my balance? what is the most I can afford?") == ["balance", "max_affordable"]
+    assert classify_intents("Can I buy a Refrigerator worth 50k INR by the end of next month?") == []
+
+
+def test_full_sentence_is_cut_into_all_parts():
+    parsed = parse_request("Can I buy a Refrigerator worth 50k INR by the end of next month? I will pay in full without any installments", AS_OF)
+    assert parsed["item"] == "Refrigerator"
+    assert parsed["deadline"]["date"] == dt.date(2024, 10, 31)
+    assert parsed["mode"]["allow_installments"] is False and parsed["mode"]["allow_partial"] is False
+    assert parsed["intents"] == []
