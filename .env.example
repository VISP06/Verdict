# ==============================================================================
# Environment Configuration (.env.example)
# Copy this file to .env and supply your credentials as needed.
# ==============================================================================

# LLM Provider Credentials
GEMINI_API_KEY=

# Model Names
# BUY_OR_WAIT_MODEL: Used by perception (receipts/messages) and default income classifier
BUY_OR_WAIT_MODEL=gemini/gemini-3.5-flash-lite

# INCOME_CLASSIFIER_MODEL: Specific model for income reliability classification
INCOME_CLASSIFIER_MODEL=gemini/gemini-3.8-flash

# Optional: Explanations and chat models
EXPLAIN_MODEL=
CHAT_MODEL=

# Classification & Batch Settings
INCOME_CACHE_PATH=dataset/income_classes.csv
INCOME_FILL_DELAY=8
INCOME_BATCH_SIZE=5
ASSISTANT_TIMEOUT_S=25

# Observability (Failproof AI)
FAILPROOF_ENV=dev
RUN_ID=
