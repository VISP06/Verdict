diff --git a/code/insights.py b/code/insights.py
new file mode 100644
index 00000000..8b16ad5a
--- /dev/null
+++ b/code/insights.py
@@ -0,0 +1,75 @@
+"""Small, model-free helpers that turn a forecast situation into things a person can act on.
+
+Every function takes the dict returned by Assistant.situation() (balances, minimum, breakdown)
+and only reads it; nothing is recomputed from raw data.
+"""
+import datetime as dt
+
+
+def safe_to_spend_today(situation):
+    """The largest single payment today that keeps the balance at or above the minimum all window long."""
+    return max(0.0, float(situation["lowest_projected_balance"]) - float(situation["minimum_balance"]))
+
+
+def capacity_from(situation, date):
+    """Largest single payment on `date` that keeps every later day at or above the minimum."""
+    balances = situation.get("balances", {})
+    later = [value for day, value in balances.items() if day >= date]
+    if not later:
+        return 0.0
+    return max(0.0, min(later) - float(situation["minimum_balance"]))
+
+
+def _flows(situation):
+    flows_by_day = (situation.get("breakdown") or {}).get("flows_by_day", {})
+    seen = set()
+    for day in sorted(flows_by_day):
+        for flow in flows_by_day[day]:
+            amount = float(flow.get("amount", 0) or 0)
+            label = str(flow.get("description") or flow.get("series_key") or flow.get("category") or "").strip()
+            key = (day, round(amount, 2), label.lower())
+            if key in seen:
+                continue
+            seen.add(key)
+            yield day, flow, amount, label
+
+
+def upcoming_income(situation, as_of=None):
+    """Counted income flows that arrive after today, soonest first."""
+    as_of = as_of or min(situation.get("balances", {"": ""}))
+    rows = []
+    for day, flow, amount, label in _flows(situation):
+        if flow.get("source") == "income" and amount > 0 and day > as_of:
+            rows.append({"date": day, "amount": amount, "label": label or "income"})
+    return rows
+
+
+def upcoming_bills(situation, days=30, limit=5, as_of=None):
+    """The largest fixed bills (recurring or scheduled) within the next `days` days."""
+    as_of = as_of or min(situation.get("balances", {"": ""}))
+    horizon = (dt.date.fromisoformat(as_of) + dt.timedelta(days=days)).isoformat()
+    rows = []
+    for day, flow, amount, label in _flows(situation):
+        if amount < 0 and flow.get("source") in {"recurring_series", "scheduled_event"} and as_of <= day <= horizon:
+            rows.append({"date": day, "amount": -amount, "label": label or str(flow.get("category") or "bill"),
+                         "category": str(flow.get("category") or "")})
+    return sorted(rows, key=lambda row: -row["amount"])[:limit]
+
+
+def everyday_spending_per_day(situation):
+    """Average projected everyday (non-fixed) spending per day; 0 when none is projected."""
+    balances = situation.get("balances", {})
+    if not balances:
+        return 0.0
+    total = 0.0
+    for _, flow, amount, _ in _flows(situation):
+        if amount < 0 and flow.get("source") not in {"recurring_series", "scheduled_event"}:
+            total += -amount
+    return total / max(1, len(balances))
+
+
+def cushion_label(cushion_after, minimum):
+    """'comfortable', 'tight' or 'unsafe' from the margin left above the minimum balance."""
+    if cushion_after < 0:
+        return "unsafe"
+    return "comfortable" if cushion_after >= 0.15 * max(1.0, float(minimum)) else "tight"
diff --git a/code/request_parser.py b/code/request_parser.py
new file mode 100644
index 00000000..7b435f47
--- /dev/null
+++ b/code/request_parser.py
@@ -0,0 +1,241 @@
+"""Deterministic parsing of one free-text request into the pieces the advisor needs.
+
+A sentence such as "Can I buy a refrigerator worth 50k INR by the end of next month?
+I will pay in full without any installments" is cut into an item, a deadline and a
+payment style. Each piece is optional: anything not found is returned as None so the
+caller can ask for it. Nothing here calls a model.
+"""
+import calendar
+import datetime as dt
+import re
+
+MONTHS = {name: index for index, names in enumerate(
+    [("january", "jan"), ("february", "feb"), ("march", "mar"), ("april", "apr"), ("may",),
+     ("june", "jun"), ("july", "jul"), ("august", "aug"), ("september", "sep", "sept"),
+     ("october", "oct"), ("november", "nov"), ("december", "dec")], start=1) for name in names}
+WEEKDAYS = {"monday": 0, "mon": 0, "tuesday": 1, "tue": 1, "tues": 1, "wednesday": 2, "wed": 2,
+            "thursday": 3, "thu": 3, "thur": 3, "thurs": 3, "friday": 4, "fri": 4,
+            "saturday": 5, "sat": 5, "sunday": 6, "sun": 6}
+NUMBER_WORDS = {"a": 1, "an": 1, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7,
+                "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12, "fifteen": 15, "eighteen": 18,
+                "twenty": 20, "twenty-four": 24, "thirty": 30}
+_NUM = r"(\d+|" + "|".join(sorted(NUMBER_WORDS, key=len, reverse=True)) + r")"
+_MONTH = r"(" + "|".join(sorted(MONTHS, key=len, reverse=True)) + r")"
+_WEEKDAY = r"(" + "|".join(sorted(WEEKDAYS, key=len, reverse=True)) + r")"
+
+
+def _number(token):
+    token = token.lower()
+    return int(token) if token.isdigit() else NUMBER_WORDS[token]
+
+
+def end_of_month(day):
+    return day.replace(day=calendar.monthrange(day.year, day.month)[1])
+
+
+def add_months(day, months):
+    index = day.month - 1 + months
+    year, month = day.year + index // 12, index % 12 + 1
+    return dt.date(year, month, min(day.day, calendar.monthrange(year, month)[1]))
+
+
+def _next_day_of_month(as_of, day_number):
+    """The next date (today or later) that falls on the given day of the month."""
+    for offset in range(0, 14):
+        year_month = add_months(as_of.replace(day=1), offset)
+        if day_number <= calendar.monthrange(year_month.year, year_month.month)[1]:
+            candidate = year_month.replace(day=day_number)
+            if candidate >= as_of:
+                return candidate
+    return None
+
+
+def _month_day(as_of, month, day_number, year=None):
+    try:
+        if year is not None:
+            return dt.date(year if year > 99 else 2000 + year, month, day_number)
+        candidate = dt.date(as_of.year, month, day_number)
+        return candidate if candidate >= as_of else dt.date(as_of.year + 1, month, day_number)
+    except ValueError:
+        return None
+
+
+def parse_deadline_phrase(text, as_of, day_first=True):
+    """Return {"date", "no_deadline", "past", "span"}; date is None when nothing usable is found."""
+    if isinstance(as_of, str):
+        as_of = dt.date.fromisoformat(as_of)
+    low = str(text or "").lower()
+    result = {"date": None, "no_deadline": False, "past": False, "span": None}
+
+    def found(date, match):
+        if date is None:
+            return None
+        if date < as_of:
+            result.update(past=True, span=match.group(0))
+            return None
+        result.update(date=date, span=match.group(0))
+        return result
+
+    match = re.search(r"\b(no deadline|no due date|no rush|not urgent|no time ?limit|any ?time|whenever|just advise)\b", low)
+    if match:
+        result.update(no_deadline=True, span=match.group(0))
+        return result
+    match = re.search(r"\b(\d{4})-(\d{2})-(\d{2})\b", low)
+    if match:
+        try:
+            return found(dt.date(int(match.group(1)), int(match.group(2)), int(match.group(3))), match) or result
+        except ValueError:
+            pass
+    if (match := re.search(r"\bend of (?:the )?(?:this |current )?month\b", low)):
+        return found(end_of_month(as_of), match) or result
+    if (match := re.search(r"\bend of (?:the )?next month\b", low)):
+        return found(end_of_month(add_months(as_of, 1)), match) or result
+    if (match := re.search(r"\bend of (?:the |this )?year\b", low)):
+        return found(dt.date(as_of.year, 12, 31), match) or result
+    if (match := re.search(r"\bend of (?:the |this )?week\b", low)):
+        return found(as_of + dt.timedelta(days=(6 - as_of.weekday()) % 7), match) or result
+    if (match := re.search(r"\bend of next week\b", low)):
+        return found(as_of + dt.timedelta(days=(6 - as_of.weekday()) % 7 + 7), match) or result
+    if (match := re.search(r"\b(?:in|within|after)\s+" + _NUM + r"\s+(day|week|month|year)s?\b", low)) or \
+            (match := re.search(r"\b" + _NUM + r"\s+(day|week|month|year)s?\s+(?:from now|from today)\b", low)):
+        count, unit = _number(match.group(1)), match.group(2)
+        delta = {"day": lambda: as_of + dt.timedelta(days=count), "week": lambda: as_of + dt.timedelta(weeks=count),
+                 "month": lambda: add_months(as_of, count), "year": lambda: add_months(as_of, 12 * count)}[unit]
+        return found(delta(), match) or result
+    if (match := re.search(r"\bday after tomorrow\b", low)):
+        return found(as_of + dt.timedelta(days=2), match) or result
+    if (match := re.search(r"\btomorrow\b", low)):
+        return found(as_of + dt.timedelta(days=1), match) or result
+    if (match := re.search(r"\b(?:today|tonight)\b", low)):
+        return found(as_of, match) or result
+    if (match := re.search(r"\bnext week\b", low)):
+        return found(as_of + dt.timedelta(days=7), match) or result
+    if (match := re.search(r"\bnext month\b", low)):
+        return found(add_months(as_of, 1), match) or result
+    if (match := re.search(r"\bnext year\b", low)):
+        return found(add_months(as_of, 12), match) or result
+    if (match := re.search(r"\bthis (?:week|weekend)\b", low)):
+        return found(as_of + dt.timedelta(days=(6 - as_of.weekday()) % 7), match) or result
+    if (match := re.search(r"\bthis month\b", low)):
+        return found(end_of_month(as_of), match) or result
+    if (match := re.search(r"\b(\d{1,2})(?:st|nd|rd|th)?\s+(?:of\s+)?" + _MONTH + r"(?:\s*,?\s*(\d{4}))?\b", low)):
+        return found(_month_day(as_of, MONTHS[match.group(2)], int(match.group(1)), int(match.group(3)) if match.group(3) else None), match) or result
+    if (match := re.search(r"\b" + _MONTH + r"\s+(\d{1,2})(?:st|nd|rd|th)?(?:\s*,?\s*(\d{4}))?\b", low)):
+        return found(_month_day(as_of, MONTHS[match.group(1)], int(match.group(2)), int(match.group(3)) if match.group(3) else None), match) or result
+    if (match := re.search(r"\b(?:by|on|before|until|till)\s+the\s+(\d{1,2})(?:st|nd|rd|th)\b", low)):
+        return found(_next_day_of_month(as_of, int(match.group(1))), match) or result
+    if (match := re.search(r"\b(?:by|before|until|till|on|this|next)\s+" + _WEEKDAY + r"\b", low)):
+        target = WEEKDAYS[match.group(1)]
+        return found(as_of + dt.timedelta(days=(target - as_of.weekday()) % 7 or 7), match) or result
+    if (match := re.search(r"\b(?:by|before|until|till|in|within)\s+(?:the\s+)?(?:end of\s+)?" + _MONTH + r"\b(?!\s*\d)", low)):
+        month = MONTHS[match.group(1)]
+        year = as_of.year if month >= as_of.month else as_of.year + 1
+        return found(end_of_month(dt.date(year, month, 1)), match) or result
+    if (match := re.search(r"\b(\d{1,2})[/-](\d{1,2})[/-](\d{2,4})\b", low)):
+        first, second, year = int(match.group(1)), int(match.group(2)), int(match.group(3))
+        day, month = (first, second) if (day_first or first > 12) and second <= 12 else (second, first)
+        try:
+            return found(dt.date(year if year > 99 else 2000 + year, month, day), match) or result
+        except ValueError:
+            pass
+    return result
+
+
+def parse_payment_mode(text):
+    """What the sentence says about paying in full, in parts, or in installments."""
+    low = str(text or "").lower()
+    mode = {"allow_installments": None, "installment_count": None, "allow_partial": None,
+            "partial_fraction": None, "partial_amount_text": None}
+    negated_full = re.search(r"\b(?:not|never|cannot|can't|cant|unable to|don't|dont|won't|wont)\b[^.?!]{0,25}\bin full\b", low)
+    if re.search(r"\b(pay(?:ing)? (?:it )?(?:in full|outright|upfront in full|all at once|in one go)|full payment|lump ?sum|"
+                 r"(?:in )?one (?:go|shot|payment)|all at once|outright)\b", low) and not negated_full or \
+            (re.search(r"\bin full\b", low) and not negated_full):
+        mode.update(allow_installments=False, allow_partial=False)
+    if re.search(r"\b(?:no|without(?: any)?|not (?:using|taking|doing)|don'?t want|skip|avoid)\s+(?:emis?|installments?|instalments?|financing)\b", low):
+        mode["allow_installments"] = False
+    if re.search(r"\b(?:no|without|not in) (?:partial|parts)\b", low):
+        mode["allow_partial"] = False
+    count_match = re.search(r"\b" + _NUM + r"\s*(?:monthly\s+)?(?:installments?|instalments?|emis?|payments)\b", low) or \
+        re.search(r"\b(?:over|across|spread over|in)\s+" + _NUM + r"\s+months?\b", low)
+    if mode["allow_installments"] is not False and (count_match or re.search(r"\b(?:installments?|instalments?|emis?)\b", low)):
+        mode["allow_installments"] = True
+        if count_match:
+            mode["installment_count"] = _number(count_match.group(1))
+    if mode["allow_partial"] is not False and re.search(r"\b(partial payment|part payment|pay (?:some|part)(?: of it)? now|part now|down ?payment|half now|pay half)\b", low):
+        mode["allow_partial"] = True
+        if re.search(r"\bhalf\b", low):
+            mode["partial_fraction"] = 0.5
+    percent = re.search(r"\b(\d+(?:\.\d+)?)\s*%\s*(?:now|upfront|up front|down)\b", low)
+    if percent and mode["allow_partial"] is not False:
+        mode.update(allow_partial=True, partial_fraction=float(percent.group(1)) / 100)
+    explicit = re.search(r"\b(?:pay|put down|down ?payment of)\s+((?:[₹$€]|rs\.?|inr|usd|eur|zar|idr)?\s*[\d,.]+\s*(?:k|m|lakhs?|lacs?|crores?|cr)?)\s+(?:now|upfront|up front|first|today)\b", low)
+    if explicit and mode["allow_partial"] is not False:
+        mode.update(allow_partial=True, partial_amount_text=explicit.group(1).strip())
+    return mode
+
+
+_STOP = {"can", "could", "should", "would", "i", "we", "afford", "buy", "purchase", "get", "order", "book", "a", "an", "the",
+         "this", "that", "my", "new", "some", "to", "for", "it", "is", "do", "if", "will", "pay", "paying", "need", "want",
+         "planning", "thinking", "about", "of", "how", "much", "cost", "costs", "costing", "worth", "priced", "price", "at",
+         "rs", "inr", "usd", "eur", "zar", "idr", "k", "which", "what", "whether", "really", "just", "me", "us", "now",
+         "going", "am", "are", "have", "has", "by", "on", "in", "within", "before", "until", "and", "or", "with", "without",
+         "rest", "later", "remaining", "deadline", "whenever", "tomorrow", "today", "tonight", "next", "week", "weeks", "month",
+         "months", "year", "years", "day", "days", "end", "half", "partial", "payment", "payments", "emi", "emis", "installment",
+         "installments", "full", "no", "not", "from", "then", "when", "ok", "okay", "please", "need", "wish", "like", "up", "down",
+         "january", "february", "march", "april", "june", "july", "august", "september", "october", "november", "december",
+         "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"}
+
+
+def _pretty(words):
+    text = " ".join(words).strip()
+    if not text:
+        return None
+    return text[0].upper() + text[1:] if text == text.lower() else text
+
+
+def extract_item(text):
+    """The thing being bought, e.g. 'refrigerator', or None when it cannot be told."""
+    sentence = re.split(r"[?.!\n]", str(text or "").strip())[0]
+    match = re.search(r"\b(?:buy|purchase|get|afford|order|book|replace|upgrade to|renew|pay for)\s+(?:(?:a|an|the|my|new|some|this|that)\b\s*)?([A-Za-z][A-Za-z\- ]{1,40}?)"
+                      r"(?=\s+(?:worth|for|costing|costs?|priced|that|which|at|of|by|on|in|within|before|until|next|this)\b|\s*[\d₹$€]|$)", sentence, re.I)
+    if match:
+        words = [w for w in match.group(1).split() if w.lower() not in _STOP]
+        if words:
+            return _pretty(words)
+    leading = []
+    for word in re.findall(r"[A-Za-z][A-Za-z\-]*", sentence):
+        if word.lower() in _STOP:
+            if leading:
+                break
+            continue
+        leading.append(word)
+    return _pretty(leading[:3]) if leading else None
+
+
+def classify_intents(text):
+    """Questions that are not purchases, in the order asked: balance, max_affordable, upcoming, situation."""
+    low = str(text or "").lower()
+    intents = []
+    if re.search(r"\b(balance|how much (?:money|cash) do i have|how much do i have|what do i have)\b", low):
+        intents.append("balance")
+    if re.search(r"\b(most|maximum|max|highest|biggest|largest|how much)\b[^?.!]*\b(afford|spend|buy|pay|budget)\b|\bwhat can i (?:afford|buy|spend)\b|\bmy budget\b|\bspending (?:limit|capacity|power)\b", low):
+        intents.append("max_affordable")
+    if re.search(r"\b(upcoming|coming up|due soon|next few weeks)\b[^?.!]*\b(bills?|payments?|expenses?|outflows?|rent|emis?)\b|\bwhat (?:bills|payments|expenses)\b|\bwhen (?:is|will|do)[^?.!]*\b(salary|payday|paid|income|get paid)\b|\bnext (?:salary|payday|income)\b", low):
+        intents.append("upcoming")
+    if re.search(r"\b(situation|summary|overview|how am i doing|my finances)\b", low):
+        intents.append("situation")
+    return intents
+
+
+def parse_request(text, as_of, day_first=True):
+    """One pass over a sentence; fields not mentioned come back as None."""
+    deadline = parse_deadline_phrase(text, as_of, day_first=day_first)
+    mode = parse_payment_mode(text)
+    cleaned = str(text or "")
+    if deadline.get("span"):
+        cleaned = re.sub(re.escape(deadline["span"]), " ", cleaned, flags=re.I)
+    cleaned = re.sub(r"\b(?:pay(?:ing)? (?:it )?in full|without(?: any)? (?:installments?|emis?)|no (?:installments?|emis?)|"
+                     r"pay (?:half|\d+(?:\.\d+)?%) now|partial payment(?: ok(?:ay)?)?|\d+\s*(?:monthly\s+)?(?:installments?|emis?)|"
+                     r"in (?:three|six|twelve|\d+) (?:months|installments?))\b", " ", cleaned, flags=re.I)
+    intents = classify_intents(text)
+    return {"item": None if intents else extract_item(cleaned), "deadline": deadline, "mode": mode, "intents": intents}
