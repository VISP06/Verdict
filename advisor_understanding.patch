+                 "2024-01-03": [{"source": "income", "amount": 350.0, "description": "Pay"}]}}}
+
+
+def test_insights_capacity_income_and_bills():
+    assert insights.safe_to_spend_today(SITUATION) == 250.0
+    assert insights.capacity_from(SITUATION, "2024-01-03") == 600.0
+    assert insights.upcoming_income(SITUATION, "2024-01-01") == [{"date": "2024-01-03", "amount": 350.0, "label": "Pay"}]
+    bills = insights.upcoming_bills(SITUATION, days=30, as_of="2024-01-01")
+    assert len(bills) == 1 and bills[0]["amount"] == 150.0  # duplicate scheduled + recurring rent counted once
+    assert insights.cushion_label(-1, 100) == "unsafe"
+    assert insights.cushion_label(5, 100) == "tight"
+    assert insights.cushion_label(50, 100) == "comfortable"
